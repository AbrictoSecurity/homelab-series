# Samba AD DC — /etc/samba/smb.conf
#
# This is the reference smb.conf generated after running 08-samba-lxc.sh.
# The provisioning command (samba-tool domain provision) writes this file
# automatically. This file is for reference and post-deployment verification.
#
# Do NOT copy this verbatim — let the provisioning script generate it.
# Replace "yourname-lab.com", "CORP", and "YOURLAB" with your actual values.
#
# LXC reference:
#   Container:  CT102  dc01
#   IP:         10.10.10.3/24   gateway 10.10.10.1 (OPNsense)
#   DNS server: 10.10.10.2      (Pi-hole, which forwards corp.* back to this DC)
#
# Verify after provisioning:
#   pct exec 102 -- samba-tool domain info 127.0.0.1
#   pct exec 102 -- samba-tool fsmo show

[global]
    workgroup = YOURLAB
    realm = CORP.YOURNAME-LAB.COM
    netbios name = DC01
    server role = active directory domain controller
    dns forwarder = 10.10.10.2          # Pi-hole handles upstream DNS

    # Kerberos
    kerberos method = secrets and keytab

    # Logging
    log file = /var/log/samba/log.%m
    max log size = 1000
    logging = file

[sysvol]
    path = /var/lib/samba/sysvol
    read only = No

[netlogon]
    path = /var/lib/samba/sysvol/corp.yourname-lab.com/scripts
    read only = No
